# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Neon/Postgres (sslmode is also set in code via connect_args for reliability)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Set to 1 for one boot only: drops all tables then recreates schema (all data removed).
# Unset after use — every restart with this enabled wipes the database.
DB_PURGE_ON_NEXT_STARTUP=

# ── Initial admin bootstrap ───────────────────────────────────────────────────
# When the users table is empty, two admins are created from these (all four required).
ADMIN1_EMAIL=admin1@example.com
ADMIN1_PASSWORD=use-a-strong-password
ADMIN1_NAME=Admin 1
ADMIN2_EMAIL=admin2@example.com
ADMIN2_PASSWORD=use-a-strong-password
ADMIN2_NAME=Admin 2
# If 1: on each startup, ADMIN1/ADMIN2 password hashes are refreshed from env (testing only).
ADMIN_PASSWORD_SYNC=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated origins. Use * only for permissive dev (cookies/credentials disabled).
# With credentials (JWT in credentialed fetches), list explicit origins instead of *.
#
# Unified hosting (same URL for UI + API — Ocean Gate / DigitalOcean App Platform, Render web, local uvicorn):
# ALLOWED_ORIGINS must list that live HTTPS origin (no trailing slash)—not a former Netlify/static host after you migrate.
# Example (DigitalOcean): ALLOWED_ORIGINS=https://teamformationportal-ssr3o.ondigitalocean.app
# Split hosting (static on host A, API on host B): list every frontend origin plus localhost if needed.
# Example split: ALLOWED_ORIGINS=https://your-static-host.example.com,http://127.0.0.1:8888
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional legacy fallbacks when ALLOWED_ORIGINS is empty:
CORS_ORIGIN=http://localhost:8000
CORS_ORIGINS=

# ── Pre-declared Team Leads (optional) ────────────────────────────────────────
# Leave empty to avoid any pre-declared leads.
LEAD_EMAILS=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Outbound mail is enabled only when BOTH SMTP_USER and SMTP_PASSWORD are set.
# Gmail: use your @umt.edu.pk address and an App Password (Google Account → Security → App passwords).
SMTP_USER=
SMTP_PASSWORD=
# Gmail app passwords: paste as one word OR four groups with spaces — spaces are stripped automatically for gmail.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Seconds (Render → Gmail often needs 30+).
SMTP_TIMEOUT=30
# Set to 1 temporarily for verbose SMTP traces in server logs (remove afterward).
SMTP_DEBUG=
# Display name shown in the inbox "From" field (Gmail still sends through SMTP_USER).
EMAIL_FROM=UMT Team Portal <noreply@umt.edu.pk>
# Used in email bodies as the "open portal" link — same as your public portal URL (unified deploy: match ALLOWED_ORIGINS host).
# Do not leave an old Netlify URL here after migrating to Ocean Gate / App Platform.
# Local: http://127.0.0.1:8000 — Production example: https://teamformationportal-ssr3o.ondigitalocean.app
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Comma-separated admin inboxes that receive copies (new lead assigned by admin, course/section deletes, etc.).
ADMIN_EMAILS=

# Local server on port 8000: python -m app   or   python -m uvicorn app.main:app --host 0.0.0.0 --port 8000

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Paste your Google Service Account JSON as a single line (optional)
